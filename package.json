{
  "name": "living-sites",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/domain",
    "packages/application",
    "packages/platform",
    "packages/infrastructure",
    "packages/test-support",
    "packages/composition"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:seed": "node scripts/seed.mjs",
    "outbox:process": "node scripts/outbox-process.mjs"
  },
  "devDependencies": {
    "typescript": "5.5",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "*",
    "@types/node": "*",
    "drizzle-kit": "*"
  }
}

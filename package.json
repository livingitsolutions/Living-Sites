{
  "name": "living-sites",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm run build --prefix packages/domain && npm run build --prefix packages/platform && npm run build --prefix packages/application && npm run build --prefix packages/infrastructure && npm run build --prefix packages/test-support && npm run build --prefix packages/composition && next build",
    "typecheck": "npm run typecheck --prefix packages/domain && npm run typecheck --prefix packages/platform && npm run typecheck --prefix packages/application && npm run typecheck --prefix packages/infrastructure && npm run typecheck --prefix packages/test-support && npm run typecheck --prefix packages/composition",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run test:unit",
    "test:unit": "vitest run --exclude packages/infrastructure/src/repositories/netlify-integration.test.ts --exclude packages/infrastructure/src/repositories/organization/drizzle-integration.test.ts --exclude packages/infrastructure/src/repositories/website/drizzle-website.integration.test.ts --exclude packages/infrastructure/src/repositories/page/drizzle-page.integration.test.ts --exclude packages/infrastructure/src/repositories/page/drizzle-page-publication.integration.test.ts --exclude packages/infrastructure/src/repositories/plan-feature/drizzle-plan-feature-outbox.integration.test.ts --exclude packages/infrastructure/src/repositories/postgres-compat.test.ts --exclude packages/infrastructure/src/repositories/identity/auth-integration.test.ts --exclude packages/infrastructure/src/repositories/identity/linkage-reconciler.test.ts --exclude packages/infrastructure/src/repositories/membership/drizzle-membership.integration.test.ts --exclude packages/infrastructure/src/repositories/identity/super-admin.integration.test.ts --exclude app/admin/organizations/organization-admin.test.ts",
    "test:integration": "vitest run packages/infrastructure/src/repositories/netlify-integration.test.ts packages/infrastructure/src/repositories/organization/drizzle-integration.test.ts packages/infrastructure/src/repositories/website/drizzle-website.integration.test.ts packages/infrastructure/src/repositories/page/drizzle-page.integration.test.ts packages/infrastructure/src/repositories/page/drizzle-page-publication.integration.test.ts packages/infrastructure/src/repositories/plan-feature/drizzle-plan-feature-outbox.integration.test.ts packages/infrastructure/src/repositories/identity/auth-integration.test.ts packages/infrastructure/src/repositories/identity/linkage-reconciler.test.ts packages/infrastructure/src/repositories/membership/drizzle-membership.integration.test.ts packages/infrastructure/src/repositories/identity/super-admin.integration.test.ts app/admin/organizations/organization-admin.test.ts",
    "test:db": "vitest run packages/infrastructure/src/repositories/netlify-integration.test.ts",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:postgres-compat": "POSTGRES_COMPAT_DATABASE_URL=$POSTGRES_COMPAT_DATABASE_URL vitest run packages/infrastructure/src/repositories/postgres-compat.test.ts",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:seed": "node scripts/seed.mjs",
    "bootstrap:admin": "TSX_TSCONFIG_PATH=scripts/tsconfig.json tsx scripts/bootstrap-admin.ts",
    "auth:reset-link": "TSX_TSCONFIG_PATH=scripts/tsconfig.json tsx scripts/generate-password-reset-link.ts",
    "outbox:process": "node scripts/outbox-process.mjs",
    "netlify:db:status": "npx netlify database status",
    "netlify:db:migrate": "npx netlify database migrations apply",
    "netlify:dev": "npx netlify dev"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@eslint/js": "^9.0.0",
    "@netlify/database-dev": "0.10.1",
    "@types/node": "*",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.0.0",
    "netlify-cli": "27.1.2",
    "tsx": "^4.23.12",
    "typescript": "5.5",
    "typescript-eslint": "^8.0.0",
    "vitest": "*"
  },
  "dependencies": {
    "@livingsites/application": "file:packages/application",
    "@livingsites/composition": "file:packages/composition",
    "@livingsites/domain": "file:packages/domain",
    "@livingsites/infrastructure": "file:packages/infrastructure",
    "@livingsites/platform": "file:packages/platform",
    "@livingsites/test-support": "file:packages/test-support",
    "@netlify/database": "1.1.0",
    "@netlify/functions": "5.3.0",
    "better-auth": "1.7.1",
    "drizzle-orm": "0.45.2",
    "next": "16.3.1",
    "pg": "8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}

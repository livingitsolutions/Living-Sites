{
  "name": "@livingsites/platform",
  "version": "0.0.0",
  "private": true,
  "description": "Platform runtime layer for Living Sites. Provider-independent runtime capabilities (config, logging, telemetry, feature flags, clock, ids, health, startup). Infrastructure depends on Platform; Platform never depends on Infrastructure.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js"
    },
    "./environment": {
      "types": "./dist/environment/index.d.ts",
      "import": "./dist/environment/index.js"
    },
    "./startup": {
      "types": "./dist/startup/index.d.ts",
      "import": "./dist/startup/index.js"
    },
    "./logging": {
      "types": "./dist/logging/index.d.ts",
      "import": "./dist/logging/index.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry/index.d.ts",
      "import": "./dist/telemetry/index.js"
    },
    "./feature-flags": {
      "types": "./dist/feature-flags/index.d.ts",
      "import": "./dist/feature-flags/index.js"
    },
    "./clock": {
      "types": "./dist/clock/index.d.ts",
      "import": "./dist/clock/index.js"
    },
    "./ids": {
      "types": "./dist/ids/index.d.ts",
      "import": "./dist/ids/index.js"
    },
    "./health": {
      "types": "./dist/health/index.d.ts",
      "import": "./dist/health/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
